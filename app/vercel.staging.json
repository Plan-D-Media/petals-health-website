{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:staging",
  "outputDirectory": "dist",
  "framework": null,
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
